{
	"name": "ai-transcribe-summary",
	"version": "1.4.5",
	"description": "Record meetings, transcribe reliably past size/silence failure modes, and produce a structured summary alongside the full transcript.",
	"main": "main.js",
	"scripts": {
		"dev": "node scripts/esbuild.config.mjs",
		"test": "vitest run",
		"lint": "eslint .",
		"build": "tsc -noEmit -skipLibCheck && node scripts/esbuild.config.mjs production",
		"version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
		"link:vault": "node scripts/link-vault.mjs",
		"link:hotreload": "node scripts/install-hot-reload.mjs"
	},
	"keywords": [],
	"author": "Utkarsh Shigihalli & StarPanda",
	"contributors": [
		{
			"name": "StarPanda",
			"url": "https://github.com/StarPandaBeg"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/StarPandaBeg/ai-transcribe-summary.git"
	},
	"homepage": "https://github.com/StarPandaBeg/ai-transcribe-summary#readme",
	"bugs": {
		"url": "https://github.com/StarPandaBeg/ai-transcribe-summary/issues"
	},
	"license": "MIT",
	"type": "module",
	"devDependencies": {
		"@types/node": "^22.10.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "^1.7.2",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2",
		"vitest": "^4.1.11"
	}
}
